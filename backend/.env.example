# Copy to backend/.env. This URL matches the local compose.yaml.
DATABASE_URL=postgresql://resume:resume_local_only@127.0.0.1:5432/resume_optimizer
API_PORT=3001
SEED_DEMO=true
MOCK_SCENARIOS=true
# NODE_ENV=production always disables demo seeding and error simulations.
# Integration tests create and remove isolated schemas on this server.
TEST_DATABASE_URL=postgresql://resume:resume_local_only@127.0.0.1:5432/resume_optimizer

# Server-only OpenAI configuration. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
RESUME_AI_ENABLED=true
# Astra is fixed in backend/src/ai/astra.client.ts.
# One request, medium reasoning, max 8000 output tokens; no automatic retries.

# Optional server-only prompt override. Relative paths resolve from backend/.
# Default: prompts/resume.local.txt if present, otherwise the public default.
# RESUME_PROMPT_FILE=prompts/resume.local.txt

# Optional document storage. Host development reads ignored ../.env.storage by default.
# Amazon S3: set bucket/region and use an IAM role (omit explicit access keys).
# S3_BUCKET=resume-documents
# S3_REGION=garage
# S3_ENDPOINT=http://127.0.0.1:3900
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:3900
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional trusted LibreOffice executable override (otherwise auto-detected).
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
