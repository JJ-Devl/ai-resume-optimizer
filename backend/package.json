{
  "name": "@resume-optimizer/backend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && nest start --watch",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "prisma:generate": "prisma generate",
    "db:setup": "node scripts/db-setup.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "prisma": "^7.10.0"
  }
}
